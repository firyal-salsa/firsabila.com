---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    id: "01",
    name: "Shipyard",
    tags: ["Linux", "Docker", "HAProxy"],
    desc: "Mini PaaS with blue-green vs canary deployments using Linux, Docker, and HAProxy. Hands-on exploration of deployment strategies and traffic shaping at the infra level.",
    status: "personal",
    year: "2026",
    github: "https://github.com/firyal-salsa/shipyard"
  }
];

const social = [
  { label: "GitHub", href: "https://github.com/firyal-salsa", icon: "gh" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/firyal-y-salsabila/", icon: "li" },
  { label: "Medium", href: "https://medium.com/@firsabilacahyadi/about", icon: "md" },
  { label: "Instagram", href: "https://www.instagram.com/viola.tte/", icon: "ig" },
];
---

<Layout>
  <!-- ── DARK SITE ────────────────────────────────────── -->
  <div id="dark-site">

    <!-- HERO -->
    <section class="hero">
      <div class="hero-bg-grid"></div>
      <div class="container">
        <div class="hero-inner">
          <div class="hero-badge">
            <span class="dot"></span>
            <span>Open for new opportunity</span>
          </div>
          <div class="hero-name-block">
            <p class="hero-label">Firyal Yusriyah Salsabila</p>
            <h1 class="hero-name">
              <span class="line1">DevOps</span>
              <span class="line1">Engineer</span>
            </h1>
          </div>
          <div class="hero-desc-block">
            <div class="terminal-line">
              <span class="prompt">$ </span>
              <span class="cmd" id="typewriter"></span>
              <span class="cursor">▋</span>
            </div>
            <p class="hero-bio">
              <span class="hero-headline">🃏 Jack of All Trades in IT Stuff</span><br/>
              System Engineer at Enterprise Banking, Indonesia.
              A tinkerer who loves to create magical things with microcontrollers.
            </p>
          </div>
          <div class="hero-meta">
            <div class="meta-item">
              <span class="meta-label">base</span>
              <span class="meta-val">Jakarta, ID (open to relocate)</span>
            </div>
            <div class="meta-sep">·</div>
            <div class="meta-item">
              <span class="meta-label">domain</span>
              <span class="meta-val">DevOps / SRE</span>
            </div>
            <div class="meta-sep">·</div>
            <div class="meta-item">
              <span class="meta-label">sector</span>
              <span class="meta-val">Banking Infra</span>
            </div>
          </div>
        </div>
      </div>
      <div class="scroll-hint">
        <div class="scroll-line"></div>
        <span>scroll</span>
      </div>
    </section>

    <!-- ABOUT STRIP -->
    <section class="about-strip">
      <div class="container">
        <div class="strip-inner">
          <div class="strip-tag">001 / about</div>
          <div class="strip-content">
            <p>
              I highly enthusiast about designing system architectures and keeping resources 
              efficient without neglecting performance tuning and high availability.
            </p>
          </div>
          <div class="strip-skills">
            {["Kubernetes", "Confluent Kafka", "ArgoCD", "Grafana", "Ansible", "Python", "Linux"].map(s => (
              <span class="skill-chip">{s}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- PROJECTS -->
    <section class="projects" id="projects">
      <div class="container">
        <div class="section-header">
          <span class="section-tag">002 / work</span>
          <h2 class="section-title">Selected Projects</h2>
        </div>
        <div class="project-grid project-grid--single">
          {projects.map((p) => (
            <article class="project-card" data-status={p.status}>
              <div class="card-top">
                <span class="card-id">{p.id}</span>
                <span class={`card-status ${p.status}`}>{p.status}</span>
              </div>
              <h3 class="card-name">{p.name}</h3>
              <p class="card-desc">{p.desc}</p>
              <div class="card-footer">
                <div class="card-tags">
                  {p.tags.map(t => <span class="tag">{t}</span>)}
                </div>
                <div class="card-footer-right">
                  {p.github && (
                    <a href={p.github} target="_blank" rel="noopener" class="card-github">GitHub ↗</a>
                  )}
                  <span class="card-year">{p.year}</span>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- KEEP IN TOUCH -->
    <section class="contact" id="contact">
      <div class="container">
        <div class="contact-inner">
          <div class="contact-left">
            <span class="section-tag">003 / connect</span>
            <h2 class="contact-title">Keep in Touch</h2>
            <p class="contact-sub">
              Got an interesting infra problem, want to collab on a hardware project, 
              or just wanna talk DevOps? Slide in.
            </p>
          </div>
          <div class="contact-right">
            <div class="social-grid">
              {social.map(s => (
                <a href={s.href} target="_blank" rel="noopener" class="social-card">
                  <div class="social-icon-wrap">
                    <span class="social-icon-text">{s.icon}</span>
                  </div>
                  <span class="social-label">{s.label}</span>
                  <span class="social-arrow">↗</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="footer">
      <div class="container">
        <div class="footer-inner">
          <span class="footer-copy">© 2026 · built with ☕</span>
          <span class="footer-sig mono">~/personal/website</span>
        </div>
      </div>
    </footer>

  </div><!-- end dark-site -->

  <!-- ── LIGHT SITE (Another Side) ─────────────────────── -->
  <div id="light-site" class="hidden">
    <nav class="light-nav">
      <div class="container">
        <div class="light-nav-inner">
          <span class="light-nav-logo">another side</span>
          <div class="light-nav-links">
            <a href="#hobbies" class="light-nav-link active" data-tab="hobbies">my hobbies</a>
            <a href="#contribute" class="light-nav-link" data-tab="contribute">contribute</a>
          </div>
        </div>
      </div>
    </nav>

    <div class="light-content">
      <!-- HOBBIES TAB -->
      <section class="light-section" id="tab-hobbies">
        <div class="container">
          <div class="light-hero">
            <p class="light-overline">beyond the terminal</p>
            <h2 class="light-title">Things I <span class="serif-style">Love</span></h2>
          </div>
          <div class="hobby-grid">
            <!-- IoT Clay Sculpture — big card with photo grid -->
            <div class="hobby-card hc-full">
              <div class="hobby-card-header">
                <div class="hobby-emoji">🗿</div>
                <div>
                  <h3>IoT Clay Sculpture</h3>
                  <p class="hobby-sub">
                    Sometimes I need to ground myself when I've been daydreaming for too long. 
                    Sculpting helps keep my mind present and allows me to truly enjoy the moment. 
                    I have so many unconventional ideas and this medium helps bring them to life.
                  </p>
                </div>
              </div>
              <div class="clay-gallery">
                <div class="clay-photo" data-desc="Air clay tree with controllable RGB lights via Telegram bot. ESP32 + WS2812B LEDs + DHT11 temperature sensor with OLED display.">
                  <div class="clay-placeholder cp1">
                    <img src="/claytree.jpeg" alt="Clay tree" />
                    <span class="clay-chip">ESP32 · OLED · DHT11</span>
                  </div>
                  <div class="clay-overlay">
                    <p>Air clay tree — lights controllable via Telegram. ESP32 + LCD OLED + Relay + DHT11. Real-time temp display.</p>
                  </div>
                </div>
                <div class="clay-photo" data-desc="Mushroom lamp sculpture with moisture sensor. Glows warmer when humidity rises.">
                  <div class="clay-placeholder cp2">
                    <span class="clay-icon">🍄</span>
                    <span class="clay-chip">ESP8266 · Sensor</span>
                  </div>
                  <div class="clay-overlay">
                    <p>Mushroom lamp with ambient moisture sensor — glows warmer as humidity rises. ESP8266 + NeoPixel ring.</p>
                  </div>
                </div>
                <div class="clay-photo" data-desc="Mini terrarium dome with automated misting and sunset LED cycle.">
                  <div class="clay-placeholder cp3">
                    <span class="clay-icon">🪴</span>
                    <span class="clay-chip">RP2040 · Servo</span>
                  </div>
                  <div class="clay-overlay">
                    <p>Terrarium dome with automated misting system and sunset LED cycle. RP2040 + servo + RTC module.</p>
                  </div>
                </div>
              </div>
              <div class="hobby-tags">
                <span>Air Clay</span><span>ESP32</span><span>OLED</span><span>DHT11</span><span>Telegram Bot</span><span>WS2812B</span><span>MQTT</span>
              </div>
            </div>

            <!-- Gaming -->
            <div class="hobby-card">
              <div class="hobby-emoji">🎮</div>
              <h3>Gaming</h3>
              <p>Strategy, puzzles, and atmospheric horror. From commanding civilizations in Rise of Nations to solving intricate puzzles in The Room, building villages in Clash of Clans, feeling the rhythm in Deemo, and surviving the dread of Mermaid Swamp, Ib, and Mad Father.</p>
              <div class="hobby-tags">
                <span>Rise of Nations</span><span>Clash of Clans</span><span>Deemo</span><span>The Room</span><span>RPG Puzzle</span>
              </div>
            </div>

            <!-- Reading -->
            <div class="hobby-card">
              <div class="hobby-emoji">📚</div>
              <h3>Reading</h3>
              <p>Philosophical inquiry and classic literature. The kind of books that rearrange how you think — Stoicism, existentialism, and the great works that have outlasted their centuries.</p>
              <div class="hobby-tags"><span>Philosophy</span><span>Classic Lit</span><span>Stoicism</span></div>
            </div>

            <!-- Swimming -->
            <div class="hobby-card">
              <div class="hobby-emoji">🏊</div>
              <h3>Swimming</h3>
              <p>The one place with no terminals, no alerts, no pagers. Just water, rhythm, and thinking through problems without realizing it.</p>
              <div class="hobby-tags"><span>Freestyle</span><span>Meditative</span></div>
            </div>
          </div>
        </div>
      </section>

      <!-- CONTRIBUTE TAB -->
      <section class="light-section hidden" id="tab-contribute">
        <div class="container">
          <div class="light-hero">
            <p class="light-overline">open source & community</p>
            <h2 class="light-title">How I <span class="serif-style">Give Back</span></h2>
          </div>
          <div class="contribute-grid">
            <!-- Mission statement — full width -->
            <div class="contrib-card cc-mission">
              <div class="mission-icon">🌱</div>
              <p class="mission-text">
                I live by the mission that technology was born to empower living creatures 
                to make Earth a better place. Enthusiast about climate change (SDG 13) and 
                keen on renewable energy + sustainable tech solutions that actually matter.
              </p>
            </div>

            <!-- Ocean volunteering -->
            <div class="contrib-card cc-featured">
              <span class="contrib-label">volunteering</span>
              <h3>🐠 Ocean Young Guard Volunteering Trip</h3>
              <p>Joined the Ocean Young Guard program for an on-ground volunteering trip focused on coral reef restoration.</p>
              <div class="hobby-tags" style="margin-top:0.25rem">
                <span>Coral Restoration</span><span>Marine Ecology</span><span>Conservation</span>
              </div>
            </div>

            <div class="contrib-card">
              <span class="contrib-label">writing</span>
              <h3>Technical Writing on Medium</h3>
              <p>I document real-world DevOps war stories like incidents survived, patterns that saved us, and lessons learned the hard way in production.</p>
              <a href="https://medium.com" target="_blank" class="contrib-link">Read on Medium ↗</a>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div><!-- end light-site -->

  <!-- ── SIDE TOGGLE ────────────────────────────────────── -->
  <button id="mode-toggle" aria-label="Switch mode">
    <span class="toggle-tooltip">another side of me</span>
    <div class="toggle-inner">
      <span class="toggle-icon dark-icon">◑</span>
      <span class="toggle-icon light-icon" style="display:none">◐</span>
    </div>
  </button>

</Layout>

<style>
/* ── HERO ────────────────────────────────────────────── */
.hero {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  position: relative;
  padding: 6rem 0 4rem;
  overflow: hidden;
}

.hero-bg-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(184,197,214,0.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(184,197,214,0.04) 1px, transparent 1px);
  background-size: 60px 60px;
  mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 40%, transparent 100%);
}

.hero-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: auto auto auto;
  gap: 0;
  position: relative;
}

.hero-badge {
  grid-column: 1 / -1;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background: var(--c-glow);
  border: 1px solid var(--c-border);
  border-radius: 100px;
  padding: 0.3rem 0.9rem;
  width: fit-content;
  margin-bottom: 2.5rem;
  font-size: 11px;
  color: var(--c-mid);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  animation: fadeIn 0.8s var(--ease-out) both;
}

.dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: #4ade80;
  box-shadow: 0 0 6px #4ade80;
  animation: pulse 2s infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50%       { opacity: 0.7; transform: scale(0.85); }
}

.hero-name-block {
  grid-column: 1 / 2;
  animation: fadeUp 0.9s 0.1s var(--ease-out) both;
}

.hero-label {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--c-mid);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  margin-bottom: 0.75rem;
}

.hero-name {
  font-family: var(--font-display);
  font-size: clamp(3.2rem, 7vw, 6rem);
  font-weight: 800;
  line-height: 0.95;
  letter-spacing: -0.04em;
  color: var(--c-fog);
}
.hero-name .line1 { display: block; }
.hero-name .line2 {
  display: block;
  font-family: var(--font-serif);
  font-weight: 400;
  font-style: italic;
  color: var(--c-steel);
}
.hero-name .line3 { display: block; }

.hero-desc-block {
  grid-column: 2 / 3;
  grid-row: 2 / 3;
  padding-top: 2rem;
  padding-left: 3rem;
  animation: fadeUp 0.9s 0.2s var(--ease-out) both;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.terminal-line {
  font-family: var(--font-mono);
  font-size: 12px;
  color: var(--c-mid);
  margin-bottom: 1.25rem;
  padding: 0.6rem 1rem;
  background: var(--c-glow);
  border: 1px solid var(--c-border);
  border-radius: 6px;
  display: flex;
  align-items: center;
  gap: 0.25rem;
}
.prompt { color: #4ade80; }
.cmd { color: var(--c-fog); }
.cursor { color: var(--c-fog); animation: blink 1s step-end infinite; }

.hero-bio {
  font-size: 13.5px;
  color: var(--c-mid);
  line-height: 1.8;
  max-width: 360px;
}

.hero-meta {
  grid-column: 1 / -1;
  display: flex;
  align-items: center;
  gap: 1.5rem;
  margin-top: 3.5rem;
  padding-top: 2rem;
  border-top: 1px solid var(--c-border);
  animation: fadeUp 0.9s 0.35s var(--ease-out) both;
}

.meta-item { display: flex; flex-direction: column; gap: 0.1rem; }
.meta-label { font-size: 10px; color: var(--c-mid); text-transform: uppercase; letter-spacing: 0.1em; }
.meta-val   { font-size: 13px; color: var(--c-fog); font-weight: 500; }
.meta-sep   { color: var(--c-border); font-size: 20px; }

.scroll-hint {
  position: absolute;
  bottom: 2.5rem;
  right: 2rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
  color: var(--c-mid);
  font-size: 10px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}
.scroll-line {
  width: 1px;
  height: 40px;
  background: linear-gradient(to bottom, transparent, var(--c-border));
  animation: scrollDown 1.5s ease-in-out infinite;
}
@keyframes scrollDown {
  0%, 100% { transform: scaleY(1); transform-origin: top; }
  50%       { transform: scaleY(0.5); transform-origin: top; }
}

/* ── ABOUT STRIP ─────────────────────────────────────── */
.about-strip {
  padding: 3rem 0;
  border-top: 1px solid var(--c-border);
  border-bottom: 1px solid var(--c-border);
  background: var(--c-glow);
}
.strip-inner {
  display: grid;
  grid-template-columns: 120px 1fr auto;
  gap: 2.5rem;
  align-items: start;
}
.strip-tag {
  font-size: 10px;
  color: var(--c-mid);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding-top: 0.2rem;
}
.strip-content p {
  color: var(--c-steel);
  font-size: 13.5px;
  line-height: 1.85;
}
.strip-skills {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  align-items: flex-end;
  flex-wrap: wrap;
  max-width: 220px;
}
.skill-chip {
  font-size: 10px;
  font-family: var(--font-mono);
  padding: 0.2rem 0.65rem;
  border: 1px solid var(--c-border);
  border-radius: 100px;
  color: var(--c-mid);
  background: var(--c-glow);
  white-space: nowrap;
  transition: border-color 0.2s, color 0.2s;
}
.skill-chip:hover { border-color: var(--c-steel); color: var(--c-fog); }

/* ── PROJECTS ────────────────────────────────────────── */
.projects { padding: 5rem 0; }

.section-header {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  margin-bottom: 3rem;
}
.section-tag {
  font-size: 10px;
  color: var(--c-mid);
  letter-spacing: 0.12em;
  text-transform: uppercase;
}
.section-title {
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  color: var(--c-fog);
  line-height: 1;
}

.project-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  border: 1px solid var(--c-border);
  background: var(--c-border);
  border-radius: 12px;
  overflow: hidden;
}

.project-card {
  background: var(--c-bg);
  padding: 2rem 1.75rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  transition: background 0.3s;
  cursor: default;
}
.project-card:hover { background: var(--c-glow); }

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.card-id {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--c-mid);
}
.card-status {
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  padding: 0.15rem 0.55rem;
  border-radius: 100px;
  border: 1px solid;
}
.card-status.production {
  color: #4ade80;
  border-color: rgba(74, 222, 128, 0.3);
  background: rgba(74, 222, 128, 0.06);
}
.card-status.personal {
  color: var(--c-steel);
  border-color: var(--c-border);
  background: var(--c-glow);
}

.card-name {
  font-family: var(--font-display);
  font-size: 1rem;
  color: var(--c-fog);
  font-weight: 600;
  line-height: 1.3;
}
.card-desc {
  font-size: 12px;
  color: var(--c-mid);
  line-height: 1.75;
  flex: 1;
}
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding-top: 0.75rem;
  border-top: 1px solid var(--c-border);
}
.card-tags { display: flex; flex-wrap: wrap; gap: 0.3rem; }
.tag {
  font-size: 9px;
  font-family: var(--font-mono);
  padding: 0.1rem 0.45rem;
  border: 1px solid var(--c-border);
  border-radius: 3px;
  color: var(--c-mid);
}
.card-year {
  font-size: 10px;
  color: var(--c-border);
  font-family: var(--font-mono);
  white-space: nowrap;
}

/* ── CONTACT ─────────────────────────────────────────── */
.contact { padding: 5rem 0; border-top: 1px solid var(--c-border); }
.contact-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: center;
}
.contact-title {
  font-size: clamp(2rem, 5vw, 3.5rem);
  color: var(--c-fog);
  line-height: 1;
  margin: 0.5rem 0 1rem;
}
.contact-sub { font-size: 13px; color: var(--c-mid); line-height: 1.8; max-width: 340px; }

.social-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.75rem;
}
.social-card {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 1rem 1.25rem;
  border: 1px solid var(--c-border);
  border-radius: 10px;
  background: var(--c-glow);
  transition: border-color 0.25s, background 0.25s, transform 0.25s var(--ease-spring);
}
.social-card:hover {
  border-color: var(--c-steel);
  background: rgba(184,197,214,0.06);
  transform: translateY(-2px);
}
.social-icon-wrap {
  width: 32px; height: 32px;
  border-radius: 6px;
  background: var(--c-border);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.social-icon-text { font-size: 10px; color: var(--c-steel); font-family: var(--font-mono); font-weight: 500; }
.social-label { flex: 1; font-size: 13px; color: var(--c-fog); font-weight: 500; }
.social-arrow { font-size: 14px; color: var(--c-mid); }

/* ── FOOTER ──────────────────────────────────────────── */
.footer {
  padding: 2rem 0;
  border-top: 1px solid var(--c-border);
}
.footer-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.footer-copy { font-size: 11px; color: var(--c-mid); }
.footer-sig  { font-size: 11px; color: var(--c-border); }

/* ── TOGGLE ──────────────────────────────────────────── */
#mode-toggle {
  position: fixed;
  bottom: 2rem;
  right: 2rem;
  z-index: 1000;
  background: var(--c-surface);
  border: 1px solid var(--c-border);
  border-radius: 50px;
