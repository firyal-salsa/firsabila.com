</style>

<script>
  // ── TYPEWRITER ────────────────────────────────────────
  const phrases = [
    "kubectl get pods --all-namespaces",
    "terraform apply -auto-approve",
    "git commit -m 'fix: prod is on fire'",
    "ansible-playbook harden.yml",
    "docker build -t magic:latest .",
    "systemctl restart everything",
  ];
  let pi = 0, ci = 0, deleting = false;
  const el = document.getElementById('typewriter');

  function type() {
    if (!el) return;
    const current = phrases[pi];
    if (!deleting) {
      el.textContent = current.slice(0, ++ci);
      if (ci === current.length) {
        deleting = true;
        setTimeout(type, 2200);
        return;
      }
    } else {
      el.textContent = current.slice(0, --ci);
      if (ci === 0) {
        deleting = false;
        pi = (pi + 1) % phrases.length;
      }
    }
    setTimeout(type, deleting ? 35 : 65);
  }
  setTimeout(type, 1000);

  // ── MODE TOGGLE ───────────────────────────────────────
  const toggle = document.getElementById('mode-toggle');
  const darkSite = document.getElementById('dark-site');
  const lightSite = document.getElementById('light-site');
  const darkIcon = document.querySelector('.dark-icon') as HTMLElement;
  const lightIcon = document.querySelector('.light-icon') as HTMLElement;
  let isLight = false;

  toggle?.addEventListener('click', () => {
    isLight = !isLight;
    if (isLight) {
      darkSite?.classList.add('hidden');
      lightSite?.classList.remove('hidden');
      lightSite?.classList.add('visible');
      document.body.classList.add('light-mode');
      if (darkIcon) darkIcon.style.display = 'none';
      if (lightIcon) lightIcon.style.display = 'inline';
    } else {
      darkSite?.classList.remove('hidden');
      lightSite?.classList.remove('visible');
      lightSite?.classList.add('hidden');
      document.body.classList.remove('light-mode');
      if (darkIcon) darkIcon.style.display = 'inline';
      if (lightIcon) lightIcon.style.display = 'none';
    }
  });

  // ── LIGHT NAV TABS ────────────────────────────────────
  const navLinks = document.querySelectorAll('.light-nav-link');
  navLinks.forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const tab = (link as HTMLElement).dataset.tab;
      navLinks.forEach(l => l.classList.remove('active'));
      link.classList.add('active');
      document.getElementById('tab-hobbies')?.classList.add('hidden');
      document.getElementById('tab-contribute')?.classList.add('hidden');
      document.getElementById(`tab-${tab}`)?.classList.remove('hidden');
    });
  });

  // ── SCROLL REVEAL ─────────────────────────────────────
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        (e.target as HTMLElement).style.opacity = '1';
        (e.target as HTMLElement).style.transform = 'translateY(0)';
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.project-card, .hobby-card, .contrib-card').forEach(el => {
    (el as HTMLElement).style.opacity = '0';
    (el as HTMLElement).style.transform = 'translateY(20px)';
    (el as HTMLElement).style.transition = 'opacity 0.6s var(--ease-out), transform 0.6s var(--ease-out)';
    observer.observe(el);
  });
</script>
