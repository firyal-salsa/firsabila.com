---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    name: "Shipyard",
    tags: ["Linux", "Docker", "HAProxy"],
    desc: "A mini PaaS for comparing blue-green and canary deployments, built on Linux, Docker and HAProxy. A hands-on look at deployment strategies and traffic shaping at the infrastructure level.",
    status: "personal",
    year: "2026",
    github: "https://github.com/firyal-salsa/shipyard"
  }
];

const social = [
  { label: "GitHub", href: "https://github.com/firyal-salsa", icon: "gh" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/firyal-y-salsabila/", icon: "in" },
  { label: "Medium", href: "https://medium.com/@firsabilacahyadi/about", icon: "md" },
  { label: "Instagram", href: "https://www.instagram.com/viola.tte/", icon: "ig" },
];
---

<Layout>
  <!-- ═══ WORK SIDE ═══ -->
  <div id="dark-site">

    <section class="hero">
      <div class="container hero-inner">
        <p class="hero-badge"><span class="dot"></span>Open to new opportunities</p>

        <div class="hero-name-block">
          <p class="hero-label">Firyal Yusriyah Salsabila</p>
          <h1 class="hero-name">
            <span>Database</span>
            <span class="soft">Engineer</span>
          </h1>
        </div>

        <div class="hero-desc-block">
          <div class="terminal" aria-hidden="true">
            <div class="terminal-bar"><i></i><i></i><i></i></div>
            <div class="terminal-body">
              <span class="prompt">$ </span><span id="typewriter"></span><span class="cursor">▋</span>
            </div>
          </div>
          <p class="hero-bio">
            <strong>Jack of all trades in IT.</strong><br />
            System engineer in enterprise banking, Indonesia. I basically run the operations for ETL reconciliation apps
          </p>
        </div>

        <dl class="hero-meta">
          <div><dt>Based in</dt><dd>Jakarta, open to relocate</dd></div>
          <div><dt>Focus</dt><dd>DBA and SysOps</dd></div>
          <div><dt>Sector</dt><dd>Banking infrastructure</dd></div>
        </dl>
      </div>
    </section>

    <section class="about-strip">
      <div class="container strip-inner">
        <h2 class="strip-title">About</h2>
        <div class="strip-content">
          <p>
            I am highly enthusiastic about green software theory, which can optimize queries and allocate resources to minimize energy consumption and reduce carbon footprints. 
          </p>
        </div>
        <div class="strip-skills">
          {["MS SQL Server", "Linux", "Python", "Confluent Kafka", "Ansible"].map(s => (
            <span class="chip">{s}</span>
          ))}
        </div>
      </div>
    </section>

    <section class="projects" id="projects">
      <div class="container">
        <h2 class="section-title">Selected projects</h2>
        <div class="project-grid">
          {projects.map((p) => (
            <article class="project-card">
              <div class="card-top">
                <h3 class="card-name">{p.name}</h3>
                <span class="card-status">{p.status}</span>
              </div>
              <p class="card-desc">{p.desc}</p>
              <div class="card-footer">
                <div class="card-tags">{p.tags.map(t => <span class="tag">{t}</span>)}</div>
                <div class="card-footer-right">
                  {p.github && <a href={p.github} target="_blank" rel="noopener" class="card-github">GitHub ↗</a>}
                  <span class="card-year">{p.year}</span>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="contact" id="contact">
      <div class="container contact-inner">
        <div>
          <h2 class="contact-title">Keep in touch</h2>
          <p class="contact-sub">Tuning queries, taming resource usage, or curious how greener software starts at the database? Let's compare notes. Say hi.
          </p>
        </div>
        <div class="social-grid">
          {social.map(s => (
            <a href={s.href} target="_blank" rel="noopener" class="social-card">
              <span class="social-icon">{s.icon}</span>
              <span class="social-label">{s.label}</span>
              <span class="social-arrow">↗</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <footer class="footer">
      <div class="container footer-inner">
        <span>© 2026 · built with ☕</span>
        <span class="mono">~/personal/website</span>
      </div>
    </footer>
  </div>

  <!-- ═══ ANOTHER SIDE ═══ -->
  <div id="light-site" class="hidden">
    <nav class="light-nav">
      <div class="container light-nav-inner">
        <span class="light-nav-logo">another side</span>
        <div class="light-nav-links">
          <a href="#hobbies" class="light-nav-link active" data-tab="hobbies">hobbies</a>
          <a href="#contribute" class="light-nav-link" data-tab="contribute">giving back</a>
        </div>
      </div>
    </nav>

    <div class="light-content">
      <section class="light-section" id="tab-hobbies">
        <div class="container">
          <h2 class="light-title">Things I <em>love</em></h2>
          <p class="light-lede">Away from the terminal.</p>

          <div class="hobby-grid">
            <div class="hobby-card hc-full">
              <div class="hobby-card-header">
                <span class="hobby-emoji">🗿</span>
                <div>
                  <h3>IoT clay sculpture</h3>
                  <p class="hobby-sub">
                    When I've been daydreaming too long, sculpting grounds me. It keeps my mind in the moment, and it gives my unconventional ideas a body.
                  </p>
                </div>
              </div>
              <div class="clay-gallery">
                <div class="clay-photo" tabindex="0">
                  <div class="clay-placeholder cp1">
                    <img src="/claytree.jpeg" alt="Air clay tree with glowing lights" />
                    <span class="clay-chip">ESP32 · OLED · DHT11</span>
                  </div>
                  <div class="clay-overlay"><p>Air clay tree with lights controlled over Telegram. ESP32, OLED, relay and a DHT11 showing live temperature.</p></div>
                </div>
                <div class="clay-photo" tabindex="0">
                  <div class="clay-placeholder cp2">
                    <span class="clay-icon">🍄</span>
                    <span class="clay-chip">ESP8266 · Sensor</span>
                  </div>
                  <div class="clay-overlay"><p>Mushroom lamp with a moisture sensor. It glows warmer as humidity rises. ESP8266 and a NeoPixel ring.</p></div>
                </div>
                <div class="clay-photo" tabindex="0">
                  <div class="clay-placeholder cp3">
                    <span class="clay-icon">🪴</span>
                    <span class="clay-chip">RP2040 · Servo</span>
                  </div>
                  <div class="clay-overlay"><p>Terrarium dome with automated misting and a sunset LED cycle. RP2040, servo and RTC module.</p></div>
                </div>
              </div>
              <div class="hobby-tags">
                <span>Air clay</span><span>ESP32</span><span>OLED</span><span>DHT11</span><span>Telegram bot</span><span>WS2812B</span><span>MQTT</span>
              </div>
            </div>

            <div class="hobby-card">
              <span class="hobby-emoji">🎮</span>
              <h3>Gaming</h3>
              <p>Strategy, puzzles and atmospheric horror. Commanding civilizations in Rise of Nations, solving The Room, building villages in Clash of Clans, feeling the rhythm of Deemo, and surviving Mermaid Swamp, Ib and Mad Father.</p>
              <div class="hobby-tags"><span>Rise of Nations</span><span>Clash of Clans</span><span>Deemo</span><span>The Room</span></div>
            </div>

            <div class="hobby-card">
              <span class="hobby-emoji">📚</span>
              <h3>Reading</h3>
              <p>Philosophy and classic literature, the kind of books that rearrange how you think. Stoicism, existentialism, and works that have outlasted their centuries.</p>
              <div class="hobby-tags"><span>Philosophy</span><span>Classics</span><span>Stoicism</span></div>
            </div>

            <div class="hobby-card">
              <span class="hobby-emoji">🏊</span>
              <h3>Swimming</h3>
              <p>The one place with no terminals, alerts or pagers. Just water, rhythm, and problems that get solved without noticing.</p>
              <div class="hobby-tags"><span>Freestyle</span><span>Meditative</span></div>
            </div>
          </div>
        </div>
      </section>

      <section class="light-section hidden" id="tab-contribute">
        <div class="container">
          <h2 class="light-title">How I <em>give back</em></h2>
          <p class="light-lede">Open source, community and the ocean.</p>

          <div class="contribute-grid">
            <div class="contrib-card cc-mission">
              <span class="mission-icon">🌱</span>
              <p class="mission-text">
                I care about climate action (SDG 13) and about renewable energy and sustainable tech that actually matters.
              </p>
            </div>

            <div class="contrib-card cc-featured">
              <span class="contrib-label">Volunteering</span>
              <h3>🐠 Ocean Young Guard trip</h3>
              <p>Joined an on-ground volunteering trip focused on coral reef restoration.</p>
              <div class="hobby-tags">
                <span>Coral restoration</span><span>Marine ecology</span><span>Conservation</span>
              </div>
            </div>

            <div class="contrib-card">
              <span class="contrib-label">Writing</span>
              <h3>Technical writing on Medium</h3>
              <p>Real-world DevOps war stories: incidents survived, patterns that saved us, and lessons learned the hard way in production.</p>
              <a href="https://medium.com/@firsabilacahyadi" target="_blank" rel="noopener" class="contrib-link">Read on Medium ↗</a>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>

  <button id="mode-toggle" type="button" aria-pressed="false" aria-label="Show another side of me">
    <span class="toggle-text">another side of me</span>
    <span class="toggle-icon">◑</span>
  </button>
</Layout>

<style>
/* ── HERO ── */
.hero { min-height: 100vh; display: flex; align-items: center; position: relative; padding: 6rem 0 4rem; overflow: hidden; }
.hero-inner { display: grid; grid-template-columns: 1.1fr 0.9fr; position: relative; animation: rise 0.9s var(--ease-out) both; }
@keyframes rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }

.hero-badge {
  grid-column: 1 / -1; display: inline-flex; align-items: center; gap: 0.5rem; width: fit-content;
  padding: 0.3rem 0.9rem; margin-bottom: 2.5rem; font-size: 13px; color: var(--c-muted);
  border: 1px solid var(--c-border); border-radius: 100px; background: var(--c-glow);
}
.dot { width: 7px; height: 7px; border-radius: 50%; background: var(--c-accent); box-shadow: 0 0 8px var(--c-accent); animation: pulse 2.4s infinite; }
@keyframes pulse { 50% { opacity: 0.5; transform: scale(0.8); } }

.hero-label { font-size: 15px; color: var(--c-muted); margin-bottom: 0.75rem; }
.hero-name {
  font-size: clamp(2.8rem, 7vw, 5.5rem); line-height: 1.05; letter-spacing: -0.03em; font-weight: 500;
}
.hero-name span { display: block; }
.hero-name .soft { background: linear-gradient(transparent 62%, var(--c-accent) 62%); width: fit-content; }

.hero-desc-block { padding-left: 3rem; display: flex; flex-direction: column; justify-content: flex-end; gap: 1.5rem; }
.terminal { border: 1px solid var(--c-border); border-radius: 10px; background: var(--c-ink); color: var(--c-cream); overflow: hidden; }
.terminal-bar { display: flex; gap: 6px; padding: 0.55rem 0.8rem; border-bottom: 1px solid rgba(247,242,235,0.15); }
.terminal-bar i { width: 8px; height: 8px; border-radius: 50%; background: rgba(247,242,235,0.25); }
.terminal-bar i:first-child { background: var(--c-accent); }
.terminal-body { font-family: var(--font); font-size: 13px; padding: 1rem; min-height: 3.2rem; color: var(--c-cream); }
.prompt { color: var(--c-accent); }
.cursor { color: var(--c-accent); animation: blink 1s step-end infinite; }
@keyframes blink { 50% { opacity: 0; } }

.hero-bio { font-size: 15px; color: var(--c-muted); line-height: 1.75; max-width: 380px; }
.hero-bio strong { font-size: 15px; font-weight: 500; color: var(--c-text); }

.hero-meta {
  grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 1rem 3rem;
  margin-top: 3.5rem; padding-top: 2rem; border-top: 1px solid var(--c-border);
}
.hero-meta dt { font-size: 12px; color: var(--c-muted); }
.hero-meta dd { font-size: 15px; font-weight: 500; }

/* ── ABOUT ── */
.about-strip { padding: 3.5rem 0; border-block: 1px solid var(--c-border); background: var(--c-glow); }
.strip-inner { display: grid; grid-template-columns: 140px 1fr auto; gap: 2.5rem; align-items: start; }
.strip-title { font-size: 1.25rem; }
.strip-content { display: grid; gap: 1rem; max-width: 62ch; }
.strip-content p { color: var(--c-muted); font-size: 14px; line-height: 1.8; }
.strip-skills { display: flex; flex-direction: column; align-items: flex-end; gap: 0.4rem; }
.chip { background: var(--c-grey); font-family: var(--font); font-size: 12px; padding: 0.25rem 0.75rem; border: 1px solid var(--c-border); border-radius: 100px; color: var(--c-muted); white-space: nowrap; transition: border-color 0.2s, color 0.2s; }
.chip:hover { border-color: var(--c-accent); color: var(--c-text); }

/* ── PROJECTS ── */
.projects { padding: 5rem 0; }
.section-title { font-size: clamp(1.9rem, 4vw, 2.8rem); margin-bottom: 2.5rem; letter-spacing: -0.02em; }
.project-grid { display: grid; grid-template-columns: minmax(0, 560px); }
.project-card {
  background: var(--c-surface); border: 1px solid var(--c-border); border-radius: 14px;
  padding: 2rem; display: flex; flex-direction: column; gap: 1rem; transition: border-color 0.25s, transform 0.25s var(--ease-out);
}
.project-card:hover { border-color: var(--c-accent); transform: translateY(-3px); }
.card-top { display: flex; justify-content: space-between; align-items: center; }
.card-name { font-size: 1.35rem; }
.card-status { font-size: 12px; padding: 0.15rem 0.7rem; border: 1px solid var(--c-border); border-radius: 100px; color: var(--c-text); background: var(--c-glow); }
.card-desc { font-size: 13.5px; color: var(--c-muted); line-height: 1.75; }
.card-footer { display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; flex-wrap: wrap; padding-top: 1rem; border-top: 1px solid var(--c-border); }
.card-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; }
.tag { background: var(--c-grey); font-family: var(--font); font-size: 11.5px; padding: 0.1rem 0.5rem; border: 1px solid var(--c-border); border-radius: 4px; color: var(--c-muted); }
.card-footer-right { display: flex; align-items: center; gap: 1rem; }
.card-github { font-size: 13px; color: var(--c-text); border-bottom: 2px solid var(--c-accent); }
.card-github:hover { border-color: var(--c-accent); }
.card-year { font-family: var(--font); font-size: 12px; color: var(--c-muted); }

/* ── CONTACT ── */
.contact { padding: 5rem 0; border-top: 1px solid var(--c-border); }
.contact-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
.contact-title { font-size: clamp(2.2rem, 5vw, 3.6rem); line-height: 1; letter-spacing: -0.025em; margin-bottom: 1rem; }
.contact-sub { color: var(--c-muted); max-width: 36ch; line-height: 1.8; }
.social-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
.social-card { display: flex; align-items: center; gap: 0.75rem; padding: 1rem 1.2rem; border: 1px solid var(--c-border); border-radius: 12px; background: var(--c-surface); transition: border-color 0.25s, transform 0.25s var(--ease-out); }
.social-card:hover { border-color: var(--c-accent); transform: translateY(-2px); }
.social-icon { width: 34px; height: 34px; border-radius: 8px; background: var(--c-accent); display: grid; place-items: center; font-family: var(--font); font-size: 12px; color: var(--c-ink); }
.social-label { flex: 1; font-weight: 500; }
.social-arrow { color: var(--c-muted); }

.footer { padding: 2rem 0; border-top: 1px solid var(--c-border); font-size: 13px; color: var(--c-muted); }
.footer-inner { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
.mono { font-family: var(--font); }

/* ── TOGGLE ── */
#mode-toggle {
  position: fixed; right: 1.5rem; bottom: 1.5rem; z-index: 1000;
  display: flex; align-items: center; gap: 0.6rem; padding: 0.65rem 1.1rem;
  background: var(--c-surface); color: var(--c-text); border: 1px solid var(--c-border); border-radius: 50px;
  font: inherit; font-size: 13px; cursor: pointer; box-shadow: 0 6px 24px rgba(46,52,37,0.15);
  transition: border-color 0.25s, transform 0.25s var(--ease-out);
}
#mode-toggle:hover { border-color: var(--c-accent); transform: scale(1.04); }
.toggle-icon { font-size: 18px; color: var(--c-accent); }

/* ── ANOTHER SIDE ── */
.hidden { display: none !important; }
.light-nav { position: sticky; top: 0; z-index: 100; background: var(--c-nav); backdrop-filter: blur(12px); border-bottom: 1px solid var(--c-border); padding: 1rem 0; }
.light-nav-inner { display: flex; justify-content: space-between; align-items: center; }
.light-nav-logo { font-weight: 500; font-size: 1rem; }
.light-nav-links { display: flex; gap: 2rem; }
.light-nav-link { font-size: 14px; color: var(--c-muted); padding-bottom: 0.2rem; border-bottom: 1px solid transparent; transition: color 0.2s, border-color 0.2s; }
.light-nav-link.active, .light-nav-link:hover { color: var(--c-text); border-bottom-color: var(--c-accent); }

.light-content { padding: 4rem 0 8rem; }
.light-section { min-height: 70vh; }
.light-title { font-size: clamp(2.2rem, 6vw, 3.8rem); line-height: 1; letter-spacing: -0.03em; }
.light-title em { font-style: normal; background: linear-gradient(transparent 62%, var(--c-accent) 62%); }
.light-lede { color: var(--c-muted); margin: 0.75rem 0 3rem; }

.hobby-grid, .contribute-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
.hobby-card, .contrib-card {
  background: var(--c-surface); border: 1px solid var(--c-border); border-radius: 14px; padding: 1.75rem;
  display: flex; flex-direction: column; gap: 0.7rem; transition: transform 0.3s var(--ease-out), border-color 0.25s;
}
.hobby-card:hover, .contrib-card:hover { transform: translateY(-3px); border-color: var(--c-accent); }
.hc-full { grid-column: 1 / -1; }
.hobby-emoji { font-size: 2rem; }
.hobby-card h3, .contrib-card h3 { font-size: 1.2rem; }
.hobby-card p, .contrib-card p { font-size: 13.5px; color: var(--c-muted); line-height: 1.75; flex: 1; }
.hobby-card-header { display: flex; gap: 1rem; align-items: flex-start; margin-bottom: 0.5rem; }
.hobby-sub { max-width: 62ch; margin-top: 0.3rem; }
.hobby-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.4rem; }
.hobby-tags span { background: var(--c-grey); font-family: var(--font); font-size: 11.5px; padding: 0.15rem 0.55rem; border: 1px solid var(--c-border); border-radius: 4px; color: var(--c-muted); }

.clay-gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; margin: 0.5rem 0 1rem; }
.clay-photo { position: relative; border-radius: 12px; overflow: hidden; aspect-ratio: 3 / 4; border: 1px solid var(--c-border); cursor: pointer; }
.clay-placeholder { position: relative; width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.6rem; transition: transform 0.4s var(--ease-out); }
.clay-placeholder img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.cp1 { background: linear-gradient(135deg, #a3b088, #8B9A6E); }
.cp2 { background: linear-gradient(135deg, #EAE2D6, #dcd2c2); }
.cp3 { background: linear-gradient(135deg, #EEEEEE, #dedede); }
.clay-icon { font-size: 2.6rem; }
.clay-chip { position: relative; font-family: var(--font); font-size: 11px; padding: 0.2rem 0.55rem; border-radius: 4px; background: rgba(20, 32, 25, 0.6); color: #e7eddf; }
.clay-overlay { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; padding: 1.2rem; background: rgba(24, 36, 29, 0.93); opacity: 0; transition: opacity 0.3s; }
.clay-overlay p { color: #e7eddf !important; font-size: 13px !important; text-align: center; flex: none !important; }
.clay-photo:hover .clay-overlay, .clay-photo:focus-visible .clay-overlay { opacity: 1; }
@media (hover: none) {
  .clay-overlay { inset: auto 0 0 0; opacity: 1; padding: 0.75rem; background: linear-gradient(transparent, rgba(24,36,29,0.95) 35%); }
  .clay-overlay p { font-size: 11.5px !important; }
  .clay-chip { display: none; }
}

.contribute-grid .cc-featured { grid-column: span 2; }
.cc-mission { grid-column: 1 / -1; flex-direction: row; align-items: center; gap: 1.5rem; background: var(--c-glow); }
.mission-icon { font-size: 2.4rem; }
.mission-text { font-size: 1.05rem !important; color: var(--c-text) !important; line-height: 1.8 !important; }
.contrib-label { font-size: 13px; color: var(--c-muted); font-weight: 500; }
.contrib-link { width: fit-content; font-size: 14px; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--c-accent); }

/* ── RESPONSIVE ── */
@media (max-width: 768px) {
  .hero { padding-top: 4rem; }
  .hero-inner { grid-template-columns: 1fr; }
  .hero-desc-block { padding: 2rem 0 0; }
  .hero-meta { gap: 1rem 2rem; margin-top: 2.5rem; }
  .strip-inner, .contact-inner { grid-template-columns: 1fr; gap: 1.5rem; }
  .strip-skills { flex-direction: row; flex-wrap: wrap; align-items: flex-start; }
  .hobby-grid, .contribute-grid { grid-template-columns: 1fr; }
  .contribute-grid .cc-featured, .hc-full, .cc-mission { grid-column: auto; }
  .cc-mission { flex-direction: column; align-items: flex-start; }
  .clay-gallery { grid-template-columns: 1fr 1fr; }
  .toggle-text { display: none; }
  #mode-toggle { padding: 0.7rem 0.85rem; }
}
</style>

<script>
  const phrases = [
    "UPDATE planet SET happy = 1 WHERE green = 1;",
    "DELETE FROM servers WHERE doing_nothing = 1;",
    "CREATE INDEX ix_save_watts ON queries (cost);",
    "SELECT TOP 5 query FROM logs ORDER BY watts DESC;"
  ];
  let pi = 0, ci = 0, deleting = false;
  const tw = document.getElementById('typewriter');
  function type() {
    if (!tw) return;
    const current = phrases[pi];
    if (!deleting) {
      tw.textContent = current.slice(0, ++ci);
      if (ci === current.length) { deleting = true; setTimeout(type, 2200); return; }
    } else {
      tw.textContent = current.slice(0, --ci);
      if (ci === 0) { deleting = false; pi = (pi + 1) % phrases.length; }
    }
    setTimeout(type, deleting ? 35 : 65);
  }
  setTimeout(type, 800);

  // Side toggle
  const toggle = document.getElementById('mode-toggle') as HTMLButtonElement | null;
  const toggleText = toggle?.querySelector('.toggle-text');
  const toggleIcon = toggle?.querySelector('.toggle-icon');
  const darkSite = document.getElementById('dark-site');
  const lightSite = document.getElementById('light-site');
  let isLight = false;

  toggle?.addEventListener('click', () => {
    isLight = !isLight;
    darkSite?.classList.toggle('hidden', isLight);
    lightSite?.classList.toggle('hidden', !isLight);
    document.body.classList.toggle('light-mode', isLight);
    toggle.setAttribute('aria-pressed', String(isLight));
    toggle.setAttribute('aria-label', isLight ? 'Back to my work' : 'Show another side of me');
    if (toggleText) toggleText.textContent = isLight ? 'back to work' : 'another side of me';
    if (toggleIcon) toggleIcon.textContent = isLight ? '◐' : '◑';
    window.scrollTo({ top: 0 });
  });

  // Light-side tabs
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.light-nav-link');
  navLinks.forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      navLinks.forEach(l => l.classList.remove('active'));
      link.classList.add('active');
      document.getElementById('tab-hobbies')?.classList.add('hidden');
      document.getElementById('tab-contribute')?.classList.add('hidden');
      document.getElementById(`tab-${link.dataset.tab}`)?.classList.remove('hidden');
    });
  });
</script>